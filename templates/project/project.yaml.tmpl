# Proyecto Coyote. Se versiona con el código; la especificación está en la herramienta.
version: 1
name: {{.Name}}
type: {{.Type}}
hub: {{printf "%q" .Hub}}        # clon del hub de la organización, o { path, ref }; vacío si no hay (ADR-0018)
language: { docs: es, code: en }
autonomy: manual                 # manual | supervised | autonomous (A1, A4)
budgets:
  monthly_usd: 0                 # 0 = sin tope definido
pace:
  profile: human                 # ritmo de escrituras en GitHub o GitLab (v0.2)
  writes_per_minute: 6
  min_gap_seconds: 3
  reserve_for_interactive: 0.2
features:                        # banderas de lo que depende de algo externo
  pr_enforcement: false          # gate pr bloquea el merge; GitHub solo exige el chequeo en repos privados con plan de pago
