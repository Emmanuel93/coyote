#!/bin/sh
# coyote: commit-msg (R15, R18). Instalado por coyote; quita del mensaje las atribuciones a herramientas de IA
# y detiene un commit que lleva secretos.
# Usa coyote si lo encuentra: patrones completos, y detiene el commit si una frase lo atribuye a una
# herramienta o si el autor es una herramienta. Si no, aplica este filtro básico con las mismas reglas.
msg="$1"
bin=$(command -v coyote 2>/dev/null)
for c in "${HOME:-/nonexistent}/go/bin/coyote" /opt/homebrew/bin/coyote /usr/local/bin/coyote; do
  [ -n "$bin" ] && break
  [ -x "$c" ] && bin="$c"
done
if [ -n "$bin" ]; then
  # R18: un commit con secretos se detiene (ADR-0016). Un coyote anterior a
  # v0.6 no conoce el comando y sale con 2: ese caso no detiene el commit.
  "$bin" secrets scan --staged --hook
  [ $? -eq 1 ] && exit 1
  exec "$bin" attribution scrub --in-place --commit-msg "$msg"
fi

b='(^|[^[:alnum:]])'
e='([^[:alnum:]]|$)'
bot='[[:alnum:]-]*(claude|cursor|copilot|codex|gemini|devin|chatgpt|jules|windsurf|codeium|tabnine|aider|amp)[[:alnum:]-]*\[bot\]'
names="${b}(claude (code|opus|sonnet|haiku|fable|mythos|[0-9])|cursor ?agent|copilot|chatgpt|gpt-?[0-9]|gemini|codeium|windsurf|codex|aider|tabnine|codewhisperer|amazon q|$bot)$e"
emails="<(noreply@anthropic\.com|cursoragent@cursor\.com|amp@ampcode\.com|noreply@openai\.com|[0-9]+\+copilot@users\.noreply\.github\.com|([0-9]+\+)?$bot@users\.noreply\.github\.com)>"
tools="(claude code|claude|github copilot|copilot|chatgpt|codex|gemini|cursor (agent|bugbot)|windsurf|aider|amazon q|tabnine|codeium)"
after='(\]|[[:space:]]*[](.,;:!?)|<]|[[:space:]]*$)'

# Autor o committer que son una herramienta: el commit se detiene.
ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null; git var GIT_COMMITTER_IDENT 2>/dev/null)
if printf '%s\n' "$ident" | LC_ALL=C grep -a -i -q -E "^[^<]*$names[^<]*<|$emails"; then
  echo "coyote: R15: el autor o committer del commit es una herramienta de IA; usa la identidad de una persona" >&2
  exit 1
fi

pattern="^[[:space:]]*co-authored-by[[:space:]]*:[^<]*$names[^<]*(<|$)|^[[:space:]]*co-authored-by[[:space:]]*:.*$emails"
pattern="$pattern|^[[:space:]]*(claude|copilot|cursor|devin|codex|windsurf|gemini|amp|jules)[- ](session|thread|task|run)(-id)?[[:space:]]*:"
pattern="$pattern|^[^[:alnum:]]*(:robot:[^[:alnum:]]*)?(<[[:alpha:]]+>[^[:alnum:]]*)*((this|este|esta)[[:space:]]+(pr|pull request|commit|change|cambio)[[:space:]]+((was|fue)[[:space:]]+)?)?(generated|created|written|made|built|developed|generad[oa]|cread[oa]|escrit[oa]|hech[oa]|desarrollad[oa])[[:space:]]+(with|by|using|via|con|por|usando|mediante)[[:space:]]+\[?$tools$after"
pattern="$pattern|claude\.ai/code/session_|app\.devin\.ai/sessions/|chatgpt\.com/codex/tasks/|jules\.google\.com/task|ampcode\.com/threads/|noreply@anthropic\.com"

# Lo que va después de la línea de tijeras (git commit -v) es el diff: git lo descarta y no se toca.
tmp="$msg.coyote.$$"
cut=$(LC_ALL=C grep -a -n -E '^. -+ >8 -+[[:space:]]*$' "$msg" | head -n 1 | cut -d: -f1)
if [ -n "$cut" ]; then
  head -n $((cut - 1)) "$msg" | LC_ALL=C grep -a -v -i -E "$pattern" > "$tmp"
  status=$?
  tail -n +"$cut" "$msg" >> "$tmp"
else
  LC_ALL=C grep -a -v -i -E "$pattern" "$msg" > "$tmp"
  status=$?
fi
# grep: 0 = quedaron líneas, 1 = no quedó ninguna (git aborta por mensaje vacío), 2 = error (se deja el mensaje).
if [ "$status" -le 1 ]; then mv "$tmp" "$msg"; else rm -f "$tmp"; fi
exit 0
